{
  "info": {
    "_postman_id": "5d6a0dbb-7361-4f1d-8b7e-792ad8fc9c6d",
    "name": "Lab05 - Registration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Independent tests for POST /registrations using setup PUT requests."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Happy path: active student with prerequisites succeeds",
      "item": [
        {
          "name": "Setup student",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}"
            },
            "url": {
              "raw": "{{baseUrl}}/students/B231234567",
              "host": ["{{baseUrl}}"],
              "path": ["students", "B231234567"]
            }
          },
          "response": []
        },
        {
          "name": "Setup course",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}"
            },
            "url": {
              "raw": "{{baseUrl}}/courses/CS313",
              "host": ["{{baseUrl}}"],
              "path": ["courses", "CS313"]
            }
          },
          "response": []
        },
        {
          "name": "POST registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Result is OK', function () { pm.expect(body.result).to.equal('OK'); });",
                  "pm.test('registrationID is present', function () { pm.expect(body).to.have.property('registrationID'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"B231234567\",\"courseID\":\"CS313\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": ["{{baseUrl}}"],
              "path": ["registrations"]
            }
          },
          "response": []
        }
      ]
    },
